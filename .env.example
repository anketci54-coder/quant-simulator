# Binance USD-M Futures public market data. MTF_V4 is simulation-only.
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_MARKET_WS_URL=wss://fstream.binance.com/market/stream?streams=!miniTicker@arr/!markPrice@arr@1s
BINANCE_BOOK_WS_URL=wss://fstream.binance.com/public/stream?streams=!bookTicker

DATABASE_PATH=quant_history_v4.db
INITIAL_BALANCE_USDT=10000
ENTRY_ENABLED=false
PANEL_BIND=127.0.0.1:8080
# Generate with: openssl rand -hex 32
PANEL_ACTION_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Account limits.
LEVERAGE=3
MAX_POSITIONS=10
MAX_TRADE_ALLOCATION=0.10
RISK_PER_TRADE=0.005
MAX_PORTFOLIO_RISK=0.02

# Cost engine. Rates are decimal; slippage and buffers are basis points.
TAKER_FEE_RATE=0.0004
ENTRY_SLIPPAGE_BPS=1
EXIT_SLIPPAGE_BPS=2
BREAK_EVEN_SAFETY_BPS=1

# Mass-market cheap filter.
MIN_QUOTE_VOLUME=20000000
MAX_SPREAD_PERCENT=0.10
HOT_SET_SIZE=64
MARKET_STALE_AFTER_MS=5000
BOOK_STALE_AFTER_MS=15000
