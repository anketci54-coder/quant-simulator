# Binance Futures Testnet public market-data endpoint.
BINANCE_BASE_URL=https://testnet.binancefuture.com

# Fresh simulation ledger balance.
INITIAL_BALANCE_USDT=10000

# Safe default: manage existing simulated positions but open no new ones.
ENTRY_ENABLED=false

# Position and portfolio risk fractions (0.005 = 0.5%, 0.02 = 2%).
RISK_PER_TRADE=0.005
MAX_PORTFOLIO_RISK=0.02
MAX_POSITIONS=10
# Prevent one-way market exposure even when total capacity is 10.
MAX_SAME_SIDE_POSITIONS=3

# Stop opening positions after a 2% session loss or three consecutive losses.
SESSION_LOSS_LIMIT=0.02
MAX_CONSECUTIVE_LOSSES=3
SYMBOL_COOLDOWN_SECONDS=3600

# Signal-quality gates.
MIN_QUOTE_VOLUME=20000000
MAX_SPREAD_PERCENT=0.10
OBI_CONFIRMATION_SAMPLES=3
# Limit depth requests to the most liquid candidates per scan.
MAX_SIGNAL_CANDIDATES=20

# Keep the panel local unless it is behind an authenticated TLS reverse proxy.
PANEL_BIND=127.0.0.1:8080
